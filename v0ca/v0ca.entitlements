<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: without this entitlement the system silently blocks the
	     microphone — no prompt, and the app never appears in the permissions list. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
