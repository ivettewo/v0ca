// Machine-local build settings. Copy to Local.xcconfig and fill in your values:
//     cp Config/Local.xcconfig.example Config/Local.xcconfig
//
// Local.xcconfig is gitignored — the Team ID never lands in the repository.
// Without DEVELOPMENT_TEAM the project builds but isn't signed: the app can't
// keep its microphone and Accessibility permissions (macOS resets them on
// every rebuild).

DEVELOPMENT_TEAM =
